GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-8b-8192
MAX_FILE_SIZE_MB=10
MAX_PAGES=10
AUDIO_BITRATE=64k
AUDIO_CHANNELS=1

# --- MongoDB ---
# Point at a real MongoDB (local or Atlas) for persistent storage, e.g.:
#   MONGODB_URI=mongodb://localhost:27017
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
# If left BLANK, the backend tries mongodb://localhost:27017 and, only if no
# server is reachable, falls back to an in-memory MongoDB emulator
# (convenient for development — data does NOT persist across restarts).
MONGODB_URI=
MONGODB_DB_NAME=docucast
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2500
MONGODB_CONNECT_TIMEOUT_MS=2500

# --- Sessions (stored in MongoDB `sessions` collection with TTL) ---
SESSION_REMEMBER_DAYS=30
SESSION_DEFAULT_DAYS=1

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
